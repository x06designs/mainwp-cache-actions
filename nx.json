{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "develop",
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "libs"
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/package-lock.json"],
    "production": [
      "default",
      "!{projectRoot}/**/*.md",
      "!{projectRoot}/tests/**/*",
      "!{projectRoot}/build/**/*",
      "!{projectRoot}/vendor/**/*",
      "!{projectRoot}/node_modules/**/*"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/build"],
      "cache": true
    },
    "gen": {
      "cache": true
    },
    "typecheck": {
      "cache": true
    },
    "check:js": {
      "cache": true
    },
    "gen:const": {
      "cache": false
    },
    "dev": {
      "cache": false
    }
  }
}

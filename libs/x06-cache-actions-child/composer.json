{
  "name": "x06designs/x06-cache-actions-child",
  "description": "X06 Cache Actions Child WordPress plugin.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4",
    "yahnis-elsts/plugin-update-checker": "^5.7"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "^6.6",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2",
    "phpunit/phpunit": "^9",
    "szepeviktor/phpstan-wordpress": "^2",
    "wp-coding-standards/wpcs": "^3.1",
    "yoast/phpunit-polyfills": "^1.1",
    "yoast/wp-test-utils": "^1.2"
  },
  "autoload": {
    "psr-4": {
      "X06CacheActionsChild\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "X06CacheActionsChild\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "platform": {
      "php": "7.4.33"
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "phpcs",
    "fix": "phpcbf",
    "phpstan": "phpstan analyse",
    "test:unit": "phpunit --testsuite unit --bootstrap tests/bootstrap-unit.php",
    "check": ["@lint", "@phpstan"]
  }
}

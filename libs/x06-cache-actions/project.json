{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "x06-cache-actions",
  "projectType": "library",
  "sourceRoot": "libs/x06-cache-actions",
  "targets": {
    "gen": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/includes/**/*.schema.json",
        "{projectRoot}/scripts/gen-constants.php",
        "{projectRoot}/package.json"
      ],
      "outputs": ["{projectRoot}/generated/types", "{projectRoot}/generated/constants.ts"],
      "cache": true,
      "options": {
        "command": "npm run gen",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["gen", "typecheck", "test:js"],
      "inputs": [
        "{projectRoot}/web/**/*",
        "{projectRoot}/generated/**/*",
        "{projectRoot}/vite.config.ts",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/package.json"
      ],
      "outputs": ["{projectRoot}/build"],
      "cache": true,
      "options": {
        "command": "npm run build:vite",
        "cwd": "{projectRoot}"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": ["gen"],
      "cache": false,
      "options": {
        "command": "npm run dev",
        "cwd": "{projectRoot}"
      }
    },
    "lib-gates": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash scripts/lib-gates.sh x06-cache-actions",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
